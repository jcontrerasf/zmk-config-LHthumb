// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/analog-stick/modes.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &lt 1 N1 &kp N2    &kp N3      &kp N4
                &kp N5   &kp N6    &kp N7      &kp N8
                &kp N9   &kp N0    &kp RSHIFT  &kp SPACE  &kp U
                &kp D    &kp A     &kp W       &kp S
            >;
        };

        second_layer {
            bindings = <
                &kp A  &kp B  &kp C  &studio_unlock
                &kp N5 &kp N6 &kp N7 &kp N8
                &kp N9 &kp N0 &kp E  &kp O  &kp U
                &kp D  &kp A  &kp W  &kp S
            >;
        };

        extra1 {
            status = "reserved";
        };

        extra2 {
            status = "reserved";
        };
    };
};
